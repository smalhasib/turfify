# ============================================================
# Turfify Backend — Environment Variables
# Copy to `.env` for local dev. NEVER commit `.env`.
# ============================================================

# --- Application ---
APP_ENV=development                          # development | staging | production
APP_DEBUG=true
APP_NAME=turfify
API_PREFIX=/v1

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/turfify

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (access tokens — generate via `python -c "import secrets; print(secrets.token_urlsafe(64))"`) ---
JWT_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_GENERATE_VIA_secrets.token_urlsafe_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8800

# --- Logging ---
LOG_LEVEL=INFO                              # DEBUG | INFO | WARNING | ERROR

# --- Feature flags / phase gating ---
EMAIL_PROVIDER=noop                         # noop | resend (Phase 2+)

# ============================================================
# The following are filled in during their respective phases.
# Listed here so the config schema is complete from day one.
# ============================================================

# --- Phase 1 (Schema): First admin bootstrap ---
INITIAL_ADMIN_PHONE=

# --- Phase 2 (Auth): Firebase ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# --- Phase 6 (Payment): bKash ---
BKASH_MODE=sandbox                          # sandbox | live
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=

# --- Phase 15 (Production): Sentry ---
SENTRY_DSN=

# --- Phase 2 (when email enabled) ---
RESEND_API_KEY=
