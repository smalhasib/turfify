# ============================================================
# Turfify Frontend — Environment Variables
# Copy to `.env.local` for local dev. NEVER commit `.env.local`.
# Variables prefixed NEXT_PUBLIC_* are exposed to the browser.
# ============================================================

# --- Backend API ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8800/v1

# --- Phase 2 (Auth): Firebase web config ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Phase 15 (Production): Sentry browser ---
NEXT_PUBLIC_SENTRY_DSN=
